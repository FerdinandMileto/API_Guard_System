java@RestController
public class DiagnosticController {
    
    @PostMapping("/api/diagnose/full")
    public ResponseEntity<?> diagnose(@RequestBody DiagnosticRequest request) {
        
        // Validación manual
        List<String> errors = new ArrayList<>();
        
        if (request.getEndpoint() == null || request.getEndpoint().isEmpty()) {
            errors.add("Endpoint es requerido");
        }
        
        if (request.getMethod() == null) {
            errors.add("Método HTTP es requerido");
        } else if (!List.of("GET", "POST", "PUT", "DELETE").contains(request.getMethod())) {
            errors.add("Método HTTP inválido: " + request.getMethod());
        }
        
        // Si hay errores, retornar 400
        if (!errors.isEmpty()) {
            return ResponseEntity
                .status(HttpStatus.BAD_REQUEST)
                .body(Map.of("errors", errors));
        }
        
        // Procesar request válido
        DiagnosticReport report = service.diagnose(request);
        return ResponseEntity.ok(report);
    }
}

