@Service
Qué es: Marca una clase como "servicio de negocio".
java@Service  // ← Spring crea UNA instancia y la gestiona
@Slf4j    // ← Lombok agrega: private static final Logger log = ...
public class AnalyticsService {
    
    // Spring inyecta esto automáticamente
    private final HealthMonitorService healthService;
    
    public LatencyStatistics calculateLatencyStats(String endpoint) {
        log.info("Calculando stats de: {}", endpoint);  // ← Logging
        
        // Lógica compleja aquí
        List<Long> latencies = getLatencies(endpoint);
        
        double mean = calculateMean(latencies);
        double p95 = calculatePercentile(latencies, 95);
        
        return LatencyStatistics.builder()
            .mean(mean)
            .p95(p95)
            .build();
    }
    
    private double calculateMean(List<Long> values) {
        return values.stream()
            .mapToLong(Long::longValue)
            .average()
            .orElse(0.0);
    }
}
