Cliente SOAP en Java (Spring Boot):
java@Component
public class SoapClient {
    
    private final WebServiceTemplate webServiceTemplate;
    
    public SoapClient(WebServiceTemplate webServiceTemplate) {
        this.webServiceTemplate = webServiceTemplate;
    }
    
    public GetUserInfoResponse getUserInfo(String userId) {
        // Crear request SOAP
        GetUserInfoRequest request = new GetUserInfoRequest();
        request.setUserId(userId);
        
        // Enviar y recibir respuesta
        GetUserInfoResponse response = (GetUserInfoResponse) 
            webServiceTemplate.marshalSendAndReceive(
                "http://api.example.com/soap/service",
                request
            );
        
        return response;
    }
}

// Configuración del WebServiceTemplate
@Configuration
public class SoapConfig {
    
    @Bean
    public WebServiceTemplate webServiceTemplate() {
        WebServiceTemplate template = new WebServiceTemplate();
        template.setDefaultUri("http://api.example.com/soap/service");
        
        // Configurar marshaller (XML ↔ Java)
        Jaxb2Marshaller marshaller = new Jaxb2Marshaller();
        marshaller.setContextPath("com.apiguard.soap.generated");
        
        template.setMarshaller(marshaller);
        template.setUnmarshaller(marshaller);
        
        return template;
    }
}

