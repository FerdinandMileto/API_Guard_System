Implementación:
java@Service
public class HealthMonitorService {
    
    // Almacenamiento en memoria
    private final Map<String, HealthCheckRequest> monitoredEndpoints = new ConcurrentHashMap<>();
    private final Map<String, List<HealthCheckResponse>> healthHistory = new ConcurrentHashMap<>();
    
    public void registerForMonitoring(HealthCheckRequest request) {
        monitoredEndpoints.put(request.getUrl(), request);
        log.info("Endpoint registrado: {}", request.getUrl());
    }
    
    @Scheduled(fixedRate = 60000)  // Cada 60 segundos
    @Async  // Thread separado
    public void scheduledMonitoring() {
        monitoredEndpoints.values().forEach(request -> {
            try {
                HealthCheckResponse response = performAdvancedCheck(request);
                saveToHistory(request.getUrl(), response);
                
                // Alertar si hay problema
                if ("DOWN".equals(response.getStatus())) {
                    alertIncident(request.getUrl(), response);
                }
            } catch (Exception e) {
                log.error("Error monitoreando {}", request.getUrl(), e);
            }
        });
    }
    
    private void saveToHistory(String url, HealthCheckResponse response) {
        healthHistory.computeIfAbsent(url, k -> new ArrayList<>()).add(response);
        
        // Mantener solo últimos 100 checks
        List<HealthCheckResponse> history = healthHistory.get(url);
        if (history.size() > 100) {
            history.remove(0);
        }
    }
}

Troubleshooting Sistemático
Qué es: Proceso estructurado para diagnosticar y resolver problemas.
Metodología en APIGuard:
Paso 1: Recolectar Información
javapublic DiagnosticReport diagnose(DiagnosticRequest request) {
    // Capturar TODO sobre la solicitud
    DiagnosticReport report = DiagnosticReport.builder()
        .endpoint(request.getEndpoint())
        .method(request.getMethod())
        .headers(request.getHeaders())
        .requestBody(request.getRequestBody())
        .build();
    
    return report;
}
Paso 2: Analizar Autenticación
javaprivate AuthenticationAnalysis analyzeAuth(DiagnosticRequest request) {
    AuthenticationAnalysis analysis = AuthenticationAnalysis.builder().build();
    
    String authType = request.getAuthenticationType();
    String authValue = request.getAuthenticationValue();
    
    // Validar formato según tipo
    switch (authType) {
        case "Bearer":
            if (!authValue.startsWith("Bearer ")) {
                analysis.setIsValid(false);
                analysis.getProblems().add("Falta prefijo 'Bearer '");
                analysis.setCorrectFormat("Authorization: Bearer YOUR_TOKEN");
            } else {
                analysis.setIsValid(true);
            }
            break;
            
        case "Basic":
            if (!authValue.contains(":")) {
                analysis.setIsValid(false);
                analysis.getProblems().add("Formato Basic inválido");
                analysis.setCorrectFormat("username:password (base64)");
            }
            break;
    }
    
    return analysis;
}
Paso 3: Validar Payload
javaprivate PayloadAnalysis analyzePayload(String payload) {
    PayloadAnalysis analysis = PayloadAnalysis.builder().build();
    
    try {
        // Intentar parsear JSON
        objectMapper.readTree(payload);
        analysis.setIsValidJson(true);
        analysis.setSizeBytes(payload.getBytes().length);
    } catch (Exception e) {
        analysis.setIsValidJson(false);
        analysis.getFormatErrors().add("JSON inválido: " + e.getMessage());
    }
    
    return analysis;
}
Paso 4: Ejecutar y Analizar
javaprivate ResponseAnalysis executeAndAnalyze(DiagnosticRequest request) {
    try {
        HttpURLConnection conn = createConnection(request);
        int statusCode = conn.getResponseCode();
        
        ResponseAnalysis analysis = ResponseAnalysis.builder()
            .statusCode(statusCode)
            .statusCategory(categorizeStatus(statusCode))
            .contentType(conn.getContentType())
            .build();
        
        return analysis;
    } catch (Exception e) {
        return buildErrorAnalysis(e);
    }
}

private String categorizeStatus(int code) {
    if (code >= 200 && code < 300) return "SUCCESS";
    if (code >= 400 && code < 500) return "CLIENT_ERROR";
    if (code >= 500) return "SERVER_ERROR";
    return "UNKNOWN";
}
Paso 5: Generar Recomendaciones
javaprivate void generateRecommendations(DiagnosticReport report) {
    List<Recommendation> recommendations = new ArrayList<>();
    
    // Si hay error de auth
    if (!report.getAuthAnalysis().getIsValid()) {
        recommendations.add(Recommendation.builder()
            .priority("CRITICAL")
            .title("Corregir autenticación")
            .description("El formato del header Authorization es incorrecto")
            .implementation("Usar: " + report.getAuthAnalysis().getCorrectFormat())
            .build());
    }
    
    // Si hay error 500
    if (report.getResponseAnalysis().getStatusCode() >= 500) {
        recommendations.add(Recommendation.builder()
            .priority("HIGH")
            .title("Contactar al equipo del servicio")
            .description("Error del servidor - problema en el backend")
            .implementation("Reportar con: endpoint, timestamp, request completo")
            .build());
    }
    
    report.setRecommendations(recommendations);
}
```

