javaprivate double calculateMean(List<Long> values) {
    return values.stream()
        .mapToLong(Long::longValue)  // Convertir a long primitivo
        .average()                    // Calcular promedio
        .orElse(0.0);                // Si lista vacía, retornar 0
}

// Uso:
