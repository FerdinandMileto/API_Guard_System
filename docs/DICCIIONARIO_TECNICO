javapublic TrendAnalysis analyzeTrend(String endpoint) {
    // Obtener historial ordenado por tiempo
    List<HealthCheckResponse> history = getHistory(endpoint, 100);
    
    // Dividir en ventanas temporales
    List<Double> window1 = getAverageLatency(history, 0, 25);   // Primeros 25%
    List<Double> window2 = getAverageLatency(history, 25, 50);  // Siguientes 25%
    List<Double> window3 = getAverageLatency(history, 50, 75);
    List<Double> window4 = getAverageLatency(history, 75, 100); // Últimos 25%
    
    // Comparar ventanas
    double avg1 = calculateMean(window1);
    double avg4 = calculateMean(window4);
    
    String trend;
    if (avg4 > avg1 * 1.2) {
        trend = "INCREASING";  // Empeoró 20%+
    } else if (avg4 < avg1 * 0.8) {
        trend = "DECREASING";  // Mejoró 20%+
    } else {
        trend = "STABLE";
    }
    
    return TrendAnalysis.builder()
        .trend(trend)
        .initialAvg(avg1)
        .currentAvg(avg4)
        .percentChange(((avg4 - avg1) / avg1) * 100)
        .build();
}

Distribución de Errores
Qué es: Analizar qué errores son más comunes y por qué.
Implementación completa:
javapublic ErrorDistribution analyzeErrorDistribution(String period) {
    // 1. Obtener todos los health checks del período
    List<HealthCheckResponse> allHistory = getAllHistoryFromPeriod(period);
    
    // 2. Filtrar solo errores (status code >= 400)
    List<HealthCheckResponse> errors = allHistory.stream()
        .filter(h -> h.getStatusCode() != null && h.getStatusCode() >= 400)
        .collect(Collectors.toList());
    
    // 3. Contar errores por código de estado
    Map<Integer, Long> errorCounts = errors.stream()
        .collect(Collectors.groupingBy(
            HealthCheckResponse::getStatusCode,
            Collectors.counting()
        ));
    
    // 4. Top 5 errores más comunes
    List<ErrorFrequency> topErrors = errorCounts.entrySet().stream()
        .sorted(Map.Entry.<Integer, Long>comparingByValue().reversed())
        .limit(5)
        .map(entry -> ErrorFrequency.builder()
            .statusCode(entry.getKey())
            .errorMessage(getErrorMessage(entry.getKey()))
            .count(entry.getValue())
            .percentage((entry.getValue() * 100.0) / errors.size())
            .affectedEndpoints(getAffectedEndpoints(errors, entry.getKey()))
            .build())
        .collect(Collectors.toList());
    
    // 5. Categorizar errores
    Map<String, Long> byCategory = new HashMap<>();
    byCategory.put("4xx_Client_Errors", errorCounts.entrySet().stream()
        .filter(e -> e.getKey() >= 400 && e.getKey() < 500)
        .mapToLong(Map.Entry::getValue)
        .sum());
    byCategory.put("5xx_Server_Errors", errorCounts.entrySet().stream()
        .filter(e -> e.getKey() >= 500)
        .mapToLong(Map.Entry::getValue)
        .sum());
    
    // 6. Calcular tasa de error
    long totalRequests = allHistory.size();
    long totalErrors = errors.size();
    double errorRate = (totalErrors * 100.0) / totalRequests;
    
    return ErrorDistribution.builder()
        .period(period)
        .totalRequests(totalRequests)
        .totalErrors(totalErrors)
        .errorRate(errorRate)
        .topErrors(topErrors)
        .errorsByCategory(byCategory)
        .build();
}
