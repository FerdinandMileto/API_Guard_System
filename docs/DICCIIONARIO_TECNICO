javapublic PerformanceSummary generateSummary() {
    // Calcular métricas de todos los endpoints
    Map<String, EndpointStats> allStats = calculateAllStats();
    
    // Generar performance por endpoint
    List<EndpointPerformance> performances = allStats.entrySet().stream()
        .map(entry -> {
            double p95 = entry.getValue().getP95();
            String grade = calculatePerformanceGrade(p95);
            
            return EndpointPerformance.builder()
                .endpoint(entry.getKey())
                .p95Latency(p95)
                .grade(grade)
                .build();
        })
        .collect(Collectors.toList());
    
    // Separar en categorías
    List<EndpointPerformance> excellent = performances.stream()
        .filter(p -> "A".equals(p.getGrade()))
        .collect(Collectors.toList());
    
    List<EndpointPerformance> needsAttention = performances.stream()
        .filter(p -> "D".equals(p.getGrade()) || "F".equals(p.getGrade()))
        .collect(Collectors.toList());
    
    // Generar alertas
    List<String> alerts = new ArrayList<>();
    if (!needsAttention.isEmpty()) {
        alerts.add(String.format(
            "⚠️ %d endpoint(s) con performance crítica (D/F)",
            needsAttention.size()
        ));
    }
    
    return PerformanceSummary.builder()
        .totalEndpoints((long) performances.size())
        .excellentEndpoints(excellent)
        .criticalEndpoints(needsAttention)
        .alerts(alerts)
        .build();
}


